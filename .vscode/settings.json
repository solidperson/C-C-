{
  "files.encoding": "utf8",
  "files.autoGuessEncoding": true,
  "editor.formatOnSave": false,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.runInTerminal": true,
  "code-runner.preserveFocus": false,
  "code-runner.executorMap": {
    "c": "chcp 65001 >nul && cd /d $dir && gcc -Wall -Wextra -g $fileName -o $fileNameWithoutExt.exe && $fileNameWithoutExt.exe",
    "cpp": "chcp 65001 >nul && cd /d $dir && g++ -Wall -Wextra -g $fileName -o $fileNameWithoutExt.exe && $fileNameWithoutExt.exe"
  },
  "terminal.integrated.defaultProfile.windows": "Command Prompt",
  "C_Cpp.default.compilerPath": "D:/msys64/ucrt64/bin/gcc.exe",
  "C_Cpp.default.cStandard": "c11",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.intelliSenseMode": "windows-gcc-x64",
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/**",
    "D:/msys64/ucrt64/include"
  ]
}
