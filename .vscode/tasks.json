{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译当前C文件",
      "type": "shell",
      "command": "gcc",
      "args": [
        "-Wall",
        "-Wextra",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "编译当前C++文件",
      "type": "shell",
      "command": "g++",
      "args": [
        "-Wall",
        "-Wextra",
        "-g",
        "-std=c++17",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": ["$gcc"],
      "group": "build"
    },
    {
      "label": "运行当前程序",
      "type": "shell",
      "command": "cmd",
      "args": ["/c", "chcp 65001 >nul && \"${fileDirname}\\${fileBasenameNoExtension}.exe\""],
      "dependsOn": "编译当前C文件",
      "problemMatcher": []
    }
  ]
}
